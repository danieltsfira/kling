# Kling AI API credentials — copy this file to `.env` and fill in your keys.
# Get them from the Kling AI developer console (API Keys page).
KLING_ACCESS_KEY=your_access_key_here
KLING_SECRET_KEY=your_secret_key_here

# Optional: override the API base URL (defaults to the global Singapore endpoint).
# KLING_API_BASE_URL=https://api-singapore.klingai.com
